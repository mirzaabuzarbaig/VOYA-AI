# API Configuration - Template for development
# Copy this file to .env and fill in real values

# Frontend API URLs
VITE_API_BASE_URL=http://localhost:8080/api
VITE_ML_SERVICE_URL=http://localhost:5000/api
VITE_USE_MOCK_DATA=false

# Backend Environment Variables (set in backend/.env or system environment)
# DB_URL=jdbc:postgresql://localhost:5432/voyaai
# DB_USERNAME=postgres
# DB_PASSWORD=your_password
# JWT_SECRET=your_base64_encoded_secret

# Optional: External Travel API Keys (set in backend environment)
# If not set, free keyless providers are used (Open-Meteo for weather, Wikipedia for places)
# WEATHER_API_KEY=your_openweathermap_api_key
# PLACES_API_KEY=your_geoapify_api_key
