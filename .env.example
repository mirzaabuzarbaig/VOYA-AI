# ═══════════════════════════════════════════════════════════════
# VoyaAI Frontend — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env for local development.
# On Vercel: Add these keys under Project Settings -> Environment Variables.

# Spring Boot REST API Base URL (must end with /api)
# Local: http://localhost:8080/api
# Production (Vercel): https://<your-spring-boot-backend>.onrender.com/api
VITE_API_BASE_URL=http://localhost:8080/api

# Python FastAPI ML Cost Prediction Service Base URL
# Local: http://localhost:8000
# Production (Vercel): https://<your-fastapi-service>.onrender.com
VITE_ML_SERVICE_URL=http://localhost:8000

# Set to false to use the live Spring Boot + PostgreSQL backend and ML service
VITE_USE_MOCK_DATA=false

# Optional: Weather API URL (defaults to OpenWeatherMap or Open-Meteo via backend)
VITE_WEATHER_API_URL=https://api.openweathermap.org/data/2.5
