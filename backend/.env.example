# ═══════════════════════════════════════════════════════════════
# VoyaAI Spring Boot Backend — Environment Configuration
# ═══════════════════════════════════════════════════════════════

# Database connection parameters
DB_URL=jdbc:postgresql://localhost:5432/voyaai
DB_USERNAME=
DB_PASSWORD=

# Server port
SERVER_PORT=8080

# CORS Allowed Origins (comma-separated React dev server URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Generate a unique Base64-encoded secret for your own environment (at least 32 random bytes).
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# ═══════════════════════════════════════════════════════════════
# External Travel APIs (Backend-Only Secrets)
# ═══════════════════════════════════════════════════════════════
# Optional: Weather API Key (e.g., OpenWeatherMap API key)
# If left blank, the backend automatically uses Open-Meteo (real-time live global weather, zero-key required)
WEATHER_API_KEY=

# Optional: Places / POI API Key (e.g., Geoapify Places API key)
# If left blank, the backend automatically uses the Wikimedia Places provider (real-time live attractions & landmarks)
PLACES_API_KEY=

# ═══════════════════════════════════════════════════════════════
# AI Provider Configuration (Backend-Only Secrets)
# ═══════════════════════════════════════════════════════════════
# Supported providers: "gemini" or "openai" (defaults to gemini)
AI_PROVIDER=gemini

# Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (optional fallback if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Python FastAPI ML Cost Prediction Service
ML_SERVICE_URL=http://localhost:8000
