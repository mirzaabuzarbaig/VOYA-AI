# ═══════════════════════════════════════════════════════════════
# VoyaAI Spring Boot Backend — Environment Configuration
# ═══════════════════════════════════════════════════════════════

# Database connection parameters (PostgreSQL)
# Local: jdbc:postgresql://localhost:5432/voyaai
# Neon Production: jdbc:postgresql://ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
# Note: Neon provides JDBC URLs in its dashboard dropdown. The URL MUST start with jdbc:postgresql://
DB_URL=jdbc:postgresql://localhost:5432/voyaai
DB_USERNAME=postgres
DB_PASSWORD=

# Server Port (Render automatically sets $PORT; locally defaults to 8080)
PORT=8080

# CORS Allowed Origins
# Comma-separated list of allowed frontend origins (no trailing slashes)
# Local: http://localhost:5173,http://localhost:5174,http://localhost:3000
# Production (Render): https://<your-voya-app>.vercel.app,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Base64-encoded secret key for JWT (minimum 256 bits / 32 bytes)
# Generate with: openssl rand -base64 32
JWT_SECRET=dGVzdC1zZWNyZXQta2V5LWZvci12b3lhYWktZGV2ZWxvcG1lbnQtMjU2Yml0cw==
JWT_EXPIRATION_MS=86400000

# ═══════════════════════════════════════════════════════════════
# External Travel APIs (Backend-Only Secrets)
# ═══════════════════════════════════════════════════════════════
# Optional: Weather API Key (e.g., OpenWeatherMap API key)
# If left blank, the backend automatically uses Open-Meteo (real-time live global weather, zero-key required)
WEATHER_API_KEY=

# Optional: Places / POI API Key (e.g., Geoapify Places API key)
# If left blank, the backend automatically uses the Wikimedia Places provider (real-time live attractions & landmarks)
PLACES_API_KEY=

# ═══════════════════════════════════════════════════════════════
# AI Provider Configuration (Backend-Only Secrets)
# ═══════════════════════════════════════════════════════════════
# Supported providers: "gemini" or "openai" (defaults to gemini)
AI_PROVIDER=gemini

# Gemini API Key (get free API key from https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (optional fallback if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Python FastAPI ML Cost Prediction Service URL
# Local: http://localhost:8000
# Production (Render): https://<your-fastapi-service>.onrender.com
ML_SERVICE_URL=http://localhost:8000
